{
  "name": "front-mili",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:client",
    "dev:client": "vite --mode client --port 5173 --strictPort",
    "dev:admin": "vite --mode admin --port 5174 --strictPort",
    "build": "npm run build:client && npm run build:admin",
    "build:client": "tsc -b tsconfig.client.json tsconfig.node.json && vite build --mode client",
    "build:admin": "tsc -b tsconfig.admin.json tsconfig.node.json && vite build --mode admin",
    "lint": "eslint .",
    "preview": "npm run preview:client",
    "preview:client": "vite preview --mode client",
    "preview:admin": "vite preview --mode admin"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4"
  }
}
